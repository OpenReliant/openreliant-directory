# Append static-auth-secret from the private secret file before starting coturn.
listening-port=3478
realm=openreliant
use-auth-secret
fingerprint
no-tls
no-tcp
no-tcp-relay
no-multicast-peers
relay-threads=1
min-port=49160
max-port=49223
total-quota=32
user-quota=8
max-bps=1000000
bps-capacity=16000000
# Do not relay traffic to private or link-local services on this host's network.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
log-file=stdout
